{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@meshesha/pptxjs": [
        "src/index.ts"
      ],
      "@meshesha/pptxjs/*": [
        "src/adapters/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vite.umd.config.ts",
    "demo"
  ]
}
